{"sections":{"breadcrumbs":{"type":"breadcrumbs","disabled":true,"settings":{"hide_mobile":false}},"main-page":{"type":"main-page","blocks":{"content":{"type":"content","settings":{}}},"block_order":["content"],"settings":{"max_width":980,"content_alignment":"start","text_alignment":"start","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"section_custom_liquid_QBqzNx":{"type":"section-custom-liquid","name":"Centre des calculateurs","settings":{"custom_liquid":"<div style=\"max-width:900px;margin:0 auto;padding:30px;\">\n\n  <h1 style=\"font-size:32px;margin-bottom:10px;text-align:center;\">\n    Centre des Calculateurs AquaCorail\n  <\/h1>\n\n  <p style=\"font-size:16px;color:#555;text-align:center;margin-bottom:40px;\">\n    Choisissez l’outil dont vous avez besoin pour planifier, ajuster et optimiser votre aquarium.\n  <\/p>\n\n  <style>\n    .calc-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n      gap: 20px;\n    }\n\n    .calc-card {\n      padding: 20px;\n      border-radius: 8px;\n      background: #f7f7f7;\n      border: 1px solid #ddd;\n      text-align: left;\n      transition: 0.2s ease;\n      cursor: pointer;\n      text-decoration: none;\n      color: inherit;\n    }\n\n    .calc-card:hover {\n      background: #e9e9e9;\n      border-color: #bbb;\n    }\n\n    .calc-card h3 {\n      margin: 0 0 8px 0;\n      font-size: 20px;\n    }\n\n    .calc-card p {\n      margin: 0;\n      color: #555;\n    }\n  <\/style>\n\n  <div class=\"calc-grid\">\n\n    <!-- Calculateur de sel -->\n    <a href=\"https:\/\/aquacorail.ca\/pages\/contact?view=calculateur-de-sel\" class=\"calc-card\">\n      <h3>Calculateur de sel<\/h3>\n      <p>Déterminez la quantité de sel nécessaire pour atteindre la salinité visée.<\/p>\n    <\/a>\n\n    <!-- Calculateur de sable -->\n    <a href=\"\/pages\/calculateur-sable\" class=\"calc-card\">\n      <h3>Calculateur de sable<\/h3>\n      <p>Calculez l’épaisseur de lit de sable souhaitée et la quantité à acheter.<\/p>\n    <\/a>\n\n    <!-- Calculateur de volume d’eau -->\n    <a href=\"https:\/\/aquacorail.ca\/pages\/calculateur?view=calculateur-real\" class=\"calc-card\">\n      <h3>Calculateur de volume d’eau<\/h3>\n      <p>Estimez le volume réel de votre aquarium en litres et en gallons.<\/p>\n    <\/a>\n\n    <!-- Calculateur poissons \/ compatibilité -->\n    <a href=\"https:\/\/aquacorail.ca\/pages\/calculateur?view=compatibilite-poissons-os\" class=\"calc-card\">\n      <h3>Calculateur de population & compatibilité<\/h3>\n      <p>Idées de poissons adaptés à votre gallonage et compatibles avec ceux déjà en place.<\/p>\n    <\/a>\n\n  <\/div>\n<\/div>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}}},"order":["breadcrumbs","main-page","section_custom_liquid_QBqzNx"]}