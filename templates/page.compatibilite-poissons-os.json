{"sections":{"breadcrumbs":{"type":"breadcrumbs","settings":{"hide_mobile":false}},"main-page":{"type":"main-page","blocks":{"title":{"type":"title","settings":{"title_size":"h1"}},"content":{"type":"content","disabled":true,"settings":{}}},"block_order":["title","content"],"settings":{"max_width":980,"content_alignment":"start","text_alignment":"start","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"section_custom_liquid_XGnRmR":{"type":"section-custom-liquid","custom_css":[],"name":"t:sections.custom_liquid.presets.name","settings":{"custom_liquid":"<section id=\"fish-calculator\" style=\"max-width:900px;margin:0 auto;padding:30px;\">\n  <h2 style=\"font-size:28px;margin-bottom:10px;text-align:center;\">\n    Calculateur de population & sélection de poissons\n  <\/h2>\n\n  <p style=\"font-size:15px;color:#555;text-align:center;margin-bottom:25px;\">\n    Entrez le volume de votre aquarium puis ajoutez les poissons souhaités. La capacité maximale\n    est calculée de façon prudente à environ 1&nbsp;po de poisson par gallon\n    (≈ 50&nbsp;% de la règle classique des 2&nbsp;po\/gal),\n    <strong>mais seulement si vous avez environ 1&nbsp;lb de roche vivante par gallon<\/strong>.\n  <\/p>\n\n  <!-- Volume de l’aquarium -->\n  <div style=\"margin-bottom:25px;\">\n    <label for=\"tankGallons\" style=\"font-weight:bold;display:block;margin-bottom:5px;\">\n      Volume de l’aquarium (en gallons) :\n    <\/label>\n    <input type=\"number\" id=\"tankGallons\" min=\"0\" step=\"any\"\n           style=\"width:100%;max-width:200px;padding:8px;\">\n\n    <p style=\"margin-top:8px;font-size:14px;color:#555;\">\n      Vous ne connaissez pas votre gallonage ?\n      <a href=\"https:\/\/aquacorail.ca\/pages\/calculateur?view=calculateur-real\">\n        Calculez votre volume ici.\n      <\/a>\n    <\/p>\n  <\/div>\n\n  <!-- Facteurs biologiques -->\n  <div style=\"border-top:1px solid #ddd;padding-top:20px;margin-top:15px;margin-bottom:20px;\">\n    <h3 style=\"font-size:18px;margin-bottom:10px;\">Configuration de votre système<\/h3>\n\n    <!-- Roches vivantes -->\n    <label for=\"rockLbs\" style=\"font-weight:bold;display:block;margin-bottom:5px;\">\n      Quantité de roche vivante dans le bac (en lb) :\n    <\/label>\n    <input type=\"number\" id=\"rockLbs\" min=\"0\" step=\"0.1\"\n           style=\"width:100%;max-width:200px;padding:8px;margin-bottom:6px;\">\n\n    <p id=\"rockRecommendation\" style=\"font-size:13px;color:#555;margin-top:4px;\">\n      Recommandation générale : 1 lb de roche vivante par gallon. Le calcul sécuritaire d’environ\n      1&nbsp;po de poisson par gallon (≈ 50&nbsp;% de la règle des 2&nbsp;po\/gal) suppose que cette\n      quantité de roches est respectée.\n    <\/p>\n\n    <!-- Type de filtration -->\n    <label for=\"filtration\" style=\"font-weight:bold;display:block;margin-top:12px;margin-bottom:5px;\">\n      Type de filtration principale :\n    <\/label>\n    <select id=\"filtration\" style=\"width:100%;max-width:260px;padding:6px;font-size:13px;\">\n      <option value=\"sump\">Sump (décantation) – performance maximale<\/option>\n      <option value=\"aio\">All-in-one<\/option>\n      <option value=\"canister\">Filtre canister<\/option>\n      <option value=\"hob\" selected>Hang on back (HOB)<\/option>\n    <\/select>\n\n    <!-- Refuge -->\n    <label style=\"display:flex;align-items:center;gap:6px;margin-top:8px;font-size:13px;\">\n      <input type=\"checkbox\" id=\"hasRefuge\">\n      <span>J’ai un refuge actif (algues, bactéries, volume d’eau supplémentaire)<\/span>\n    <\/label>\n\n    <p style=\"font-size:12px;color:#777;margin-top:8px;\">\n      Ces paramètres ajustent légèrement la capacité estimée. Une sump performante + un refuge\n      bien établi permettent une petite marge supplémentaire, mais ne remplacent pas les bonnes\n      pratiques d’entretien et de quarantaine.\n    <\/p>\n  <\/div>\n\n  <!-- Styles -->\n  <style>\n    .tank-type-toggle {\n      display:flex;\n      flex-wrap:wrap;\n      align-items:center;\n      gap:6px;\n      margin-bottom:14px;\n    }\n    .tank-type-label {\n      font-size:12px;\n      font-weight:bold;\n      margin-right:4px;\n    }\n    .tank-type-button {\n      border:1px solid #ccc;\n      background:#f5f5f5;\n      border-radius:999px;\n      padding:4px 10px;\n      font-size:12px;\n      cursor:pointer;\n      transition:background 0.2s, color 0.2s, border-color 0.2s;\n    }\n    .tank-type-button.is-active {\n      background:#0077c2;\n      color:#fff;\n      border-color:#0077c2;\n    }\n\n    .fish-groups {\n      display:flex;\n      flex-wrap:wrap;\n      gap:12px;\n    }\n    .fish-group {\n      flex:1 1 230px;\n      border:1px solid #ddd;\n      border-radius:8px;\n      background:#fafafa;\n      padding:0;\n      overflow:hidden;\n      font-size:13px;\n    }\n    .fish-group summary {\n      list-style:none;\n      cursor:pointer;\n      padding:7px 10px;\n      font-weight:600;\n      font-size:13px;\n      background:#f0f0f0;\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n    }\n    .fish-group summary::-webkit-details-marker {\n      display:none;\n    }\n    .fish-group summary span.label {\n      flex:1;\n      white-space:nowrap;\n      overflow:hidden;\n      text-overflow:ellipsis;\n    }\n    .fish-group summary span.chevron {\n      font-size:11px;\n      opacity:0.6;\n      margin-left:6px;\n    }\n    .fish-group[open] summary span.chevron {\n      transform:rotate(90deg);\n    }\n    .fish-group-body {\n      padding:8px 10px 10px;\n      font-size:12px;\n    }\n    .fish-group-body img {\n      width:100%;\n      max-width:90px;\n      border-radius:6px;\n      object-fit:cover;\n      display:block;\n      margin-bottom:6px;\n    }\n    .fish-group-row {\n      display:flex;\n      gap:8px;\n    }\n    .fish-group-main {\n      flex:1 1 auto;\n    }\n    .fish-group-side {\n      flex:0 0 90px;\n    }\n    .fish-group-body label {\n      font-size:12px;\n      font-weight:bold;\n      display:block;\n      margin-top:5px;\n      margin-bottom:2px;\n    }\n    .fish-group-body select,\n    .fish-group-body input[type=\"number\"] {\n      width:100%;\n      padding:5px;\n      font-size:12px;\n      box-sizing:border-box;\n    }\n    .fish-group-body p {\n      margin:3px 0 0;\n      font-size:11px;\n      color:#555;\n    }\n\n    \/* Résultats visuels façon AquaStockPro *\/\n    .result-panel {\n      margin-top:10px;\n      margin-bottom:15px;\n      padding:12px 14px;\n      border-radius:8px;\n      border:1px solid #ddd;\n      background:#fafafa;\n    }\n    .result-main {\n      display:flex;\n      flex-direction:column;\n      gap:8px;\n    }\n    .result-metric {\n      display:flex;\n      justify-content:space-between;\n      align-items:baseline;\n      font-size:14px;\n      font-weight:600;\n    }\n    .result-metric .result-label {\n      color:#444;\n    }\n    .result-metric .result-value {\n      font-size:15px;\n    }\n    .progress-wrapper {\n      display:flex;\n      flex-direction:column;\n      gap:4px;\n    }\n    .progress-bar-bg {\n      width:100%;\n      height:10px;\n      border-radius:999px;\n      background:#e3e3e3;\n      overflow:hidden;\n    }\n    .progress-bar-fill {\n      height:100%;\n      width:0%;\n      border-radius:999px;\n      background:#4caf50;\n      transition:width 0.25s ease-out, background 0.25s ease-out;\n    }\n    .progress-note {\n      font-size:11px;\n      align-self:flex-end;\n      padding:2px 8px;\n      border-radius:999px;\n      background:#eee;\n      color:#444;\n    }\n    .progress-note.status-idle {\n      background:#eee;\n      color:#555;\n    }\n    .progress-note.status-ok {\n      background:#e3f6e8;\n      color:#256029;\n    }\n    .progress-note.status-warn {\n      background:#fff4e0;\n      color:#8a5a05;\n    }\n    .progress-note.status-alert {\n      background:#fde4e4;\n      color:#b00020;\n    }\n\n    .result-table-wrapper {\n      margin-top:12px;\n      overflow-x:auto;\n    }\n    .result-table {\n      width:100%;\n      border-collapse:collapse;\n      font-size:12px;\n      min-width:480px;\n    }\n    .result-table thead {\n      background:#f0f0f0;\n    }\n    .result-table th,\n    .result-table td {\n      padding:6px 8px;\n      border-bottom:1px solid #e0e0e0;\n      text-align:left;\n      white-space:nowrap;\n    }\n    .result-table th {\n      font-weight:600;\n      color:#444;\n    }\n    .result-table tr:nth-child(even) td {\n      background:#fafafa;\n    }\n    .result-table-empty td {\n      text-align:center;\n      font-style:italic;\n      color:#777;\n    }\n\n    @media (max-width:700px) {\n      .result-table {\n        font-size:11px;\n      }\n      .result-panel {\n        padding:10px;\n      }\n    }\n  <\/style>\n\n  <!-- Sélection de poissons -->\n  <div id=\"fish-selection\" style=\"border-top:1px solid #ddd;padding-top:20px;margin-top:20px;\">\n    <h3 style=\"font-size:18px;margin-bottom:10px;\">Sélection de poissons<\/h3>\n\n    <!-- Type de bac -->\n    <div class=\"tank-type-toggle\">\n      <span class=\"tank-type-label\">Type de bac :<\/span>\n      <button type=\"button\" class=\"tank-type-button is-active\" data-tank-type=\"reef\">\n        Bac récifal\n      <\/button>\n      <button type=\"button\" class=\"tank-type-button\" data-tank-type=\"fish-only\">\n        Fish only\n      <\/button>\n      <button type=\"button\" class=\"tank-type-button\" data-tank-type=\"fowlr\">\n        FOWLR (fish + roches)\n      <\/button>\n    <\/div>\n\n    <div class=\"fish-groups\">\n\n      <!-- 🐠 Poisson clown (AquaCorail) -->\n      <details class=\"fish-group\" data-family=\"clownfish\" open>\n        <summary>\n          <span class=\"label\">Poisson clown<\/span>\n          <span class=\"chevron\">▶<\/span>\n        <\/summary>\n        <div class=\"fish-group-body\">\n          <div class=\"fish-group-row\">\n        