             <p style=\"margin:0 0 4px;font-size:12px;\">\n                À partir de\n                <strong>{{ all_products['kole-blue-eye-tang'].price | money }}</strong>,\n                <a href=\"https://aquacorail.ca/products/kole-blue-eye-tang\" target=\"_blank\">\n                  voir la fiche produit\n                </a>\n              </p>\n\n              <label>Variante :</label>\n              <select class=\"fish-variant-select\"\n                      data-family=\"tang\">\n                <option value=\"tang_kole\"\n                        data-length=\"7\"\n                        data-min-gallons=\"75\"\n                        data-product-url=\"https://aquacorail.ca/products/kole-blue-eye-tang\"\n                        data-product-img=\"{{ all_products['kole-blue-eye-tang'].featured_image | image_url: width: 300 }}\">\n                  Kole Blue Eye Tang – ~7\" (75 gal min.)\n                </option>\n                <option value=\"tang_med\"\n                        data-length=\"8\"\n                        data-min-gallons=\"75\">\n                  Tang moyen (Yellow, etc.) – ~8\" (75 gal min.)\n                </option>\n                <option value=\"tang_large\"\n                        data-length=\"10\"\n                        data-min-gallons=\"120\">\n                  Grand tang (ex. Naso) – ~10\" (120 gal min.)\n                </option>\n              </select>\n\n              <label>Quantité :</label>\n              <input type=\"number\"\n                     class=\"fish-qty-input\"\n                     data-family=\"tang\"\n                     min=\"0\" step=\"1\" value=\"0\">\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- WRASSE -->\n      <div class=\"fish-group\" data-family=\"wrasse\">\n        <div class=\"fish-card-header\">Wrasse</div>\n        <div class=\"fish-group-body\">\n          <div class=\"fish-group-row\">\n            <div class=\"fish-group-side\">\n              <a href=\"https://aquacorail.ca/products/6-line-wrasse\" target=\"_blank\">\n                <img\n                  src=\"{{ all_products['6-line-wrasse'].featured_image | image_url: width: 300 }}\"\n                  alt=\"Six Line Wrasse\">\n              </a>\n            </div>\n            <div class=\"fish-group-main\">\n              <p style=\"margin:0 0 4px;font-size:12px;\">\n                À partir de\n                <strong>{{ all_products['6-line-wrasse'].price | money }}</strong>,\n                <a href=\"https://aquacorail.ca/products/6-line-wrasse\" target=\"_blank\">\n                  voir la fiche produit\n                </a>\n              </p>\n\n              <label>Variante :</label>\n              <select class=\"fish-variant-select\"\n                      data-family=\"wrasse\">\n                <option value=\"wrasse_sixline\"\n                        data-length=\"3\"\n                        data-min-gallons=\"40\"\n                        data-product-url=\"https://aquacorail.ca/products/6-line-wrasse\"\n                        data-product-img=\"{{ all_products['6-line-wrasse'].featured_image | image_url: width: 300 }}\">\n                  Six Line Wrasse – ~3\" (40 gal min.)\n                </option>\n                <option value=\"wrasse_fairy\"\n                        data-length=\"4\"\n                        data-min-gallons=\"50\">\n                  Fairy ou flasher wrasse – ~4\" (50 gal min.)\n                </option>\n                <option value=\"wrasse_other\"\n                        data-length=\"5\"\n                        data-min-gallons=\"75\">\n                  Autres wrasses – ~5\" (75 gal min.)\n                </option>\n              </select>\n\n              <label>Quantité :</label>\n              <input type=\"number\"\n                     class=\"fish-qty-input\"\n                     data-family=\"wrasse\"\n                     min=\"0\" step=\"1\" value=\"0\">\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div><!-- .fish-groups -->\n  </div><!-- #fish-selection -->\n\n  <!-- Résultats visuels -->\n  <div id=\"fish-results\" style=\"margin-top:25px;border-top:1px solid #ddd;padding-top:20px;\">\n    <h3 style=\"font-size:18px;margin-bottom:8px;\">Résumé de la charge biologique</h3>\n\n    <div class=\"result-panel\">\n      <div class=\"result-main\">\n        <div class=\"result-metric\">\n          <span class=\"result-label\">Taux d’occupation du bac :</span>\n          <span class=\"result-value\" id=\"tankUsage\">-</span>\n        </div>\n\n        <div class=\"progress-wrapper\">\n          <div class=\"progress-bar-bg\">\n            <div class=\"progress-bar-fill\" id=\"tankUsageBar\"></div>\n          </div>\n          <span class=\"progress-note status-idle\" id=\"tankUsageBadge\">\n            En attente de données.\n          </span>\n        </div>\n\n        <p id=\"adviceText\" style=\"font-size:13px;color:#555;margin-top:6px;\"></p>\n        <p id=\"tankTypeNote\" style=\"font-size:12px;color:#777;margin-top:4px;\">\n          Type de bac sélectionné : Bac récifal (par défaut).\n        </p>\n      </div>\n    </div>\n\n    <h4 style=\"font-size:15px;margin:8px 0 6px;\">Poissons sélectionnés</h4>\n    <div class=\"result-table-wrapper\">\n      <table class=\"result-table\">\n        <thead>\n          <tr>\n            <th>Famille</th>\n            <th>Variante</th>\n            <th>Qté</th>\n            <th>Longueur utilisée (po)</th>\n            <th>Total (po)</th>\n            <th>Volume min. recommandé</th>\n          </tr>\n        </thead>\n        <tbody id=\"resultTableBody\">\n          <tr class=\"result-table-empty\">\n            <td colspan=\"6\">Aucun poisson sélectionné pour le moment.</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- NOUVELLE SECTION : CE QU’IL SERAIT ENCORE POSSIBLE D’AJOUTER -->\n    <div id=\"possible-additions\">\n      <h4>Ce qu’il serait encore possible d’ajouter</h4>\n      <p id=\"possibleAdditionsSummary\">\n        Une fois la capacité calculée, cette section vous donnera des idées de poissons\n        qui pourraient encore être ajoutés sans dépasser la charge biologique recommandée.\n      </p>\n      <ul id=\"possibleAdditionsList\">\n        <li>Par exemple&nbsp;: 1 petit goby ou 1 cardinal dans un bac encore peu chargé.</li>\n      </ul>\n    </div>\n  </div>\n</section>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    },
    "section_custom_liquid_GmqNNe": {
      "type": "section-custom-liquid",
      "name": "Calcul. part 2",
      "settings": {
        "custom_liquid": "<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  // Références principales\n  var tankGallonsInput   = document.getElementById('tankGallons');\n  var rockLbsInput       = document.getElementById('rockLbs');\n  var filtrationSelect   = document.getElementById('filtration');\n  var hasRefugeCheckbox  = document.getElementById('hasRefuge');\n  var tankTypeButtons    = document.getElementsByClassName('tank-type-button');\n  var tankTypeNote       = document.getElementById('tankTypeNote');\n\n  var resultTableBody    = document.getElementById('resultTableBody');\n  var tankUsageSpan      = document.getElementById('tankUsage');\n  var tankUsageBar       = document.getElementById('tankUsageBar');\n  var tankUsageBadge     = document.getElementById('tankUsageBadge');\n  var adviceText         = document.getElementById('adviceText');\n\n  var possibleSummary    = document.getElementById('possibleAdditionsSummary');\n  var possibleList       = document.getElementById('possibleAdditionsList');\n\n  if (!tankGallonsInput || !resultTableBody) {\n    return;\n  }\n\n  // --------- Utils ---------\n  function getActiveTankType() {\n    for (var i = 0; i < tankTypeButtons.length; i++) {\n      var btn = tankTypeButtons[i];\n      if (btn.className.indexOf('is-active') !== -1) {\n        return btn.getAttribute('data-tank-type') || 'reef';\n      }\n    }\n    return 'reef';\n  }\n\n  function setTankTypeNote() {\n    if (!tankTypeNote) {\n      return;\n    }\n    var type = getActiveTankType();\n    var label = 'Bac récifal';\n    if (type === 'fish-only') {\n      label = 'Fish only';\n    } else if (type === 'fowlr') {\n      label = 'FOWLR (fish + roches)';\n    }\n    tankTypeNote.textContent = 'Type de bac sélectionné : ' + label + '.';\n  }\n\n  function getDefaultLengthForFamily(family) {\n    if (!family) {\n      return 3;\n    }\n    if (family === 'butterflyfish') {\n      return 6;\n    }\n    if (family === 'dottyback') {\n      return 3;\n    }\n    if (family === 'foxface_rabbitfish') {\n      return 7;\n    }\n    if (family === 'hawkfish') {\n      return 3;\n    }\n    if (family === 'pufferfish') {\n      return 6;\n    }\n    if (family.indexOf('goby_') === 0) {\n      return 3;\n    }\n    return 3;\n  }\n\n  function formatFamilyLabel(family) {\n    if (!family) {\n      return 'Poisson';\n    }\n    var label = family.replace(/_/g, ' ');\n    return label.charAt(0).toUpperCase() + label.slice(1);\n  }\n\n  function getAdjustedCapacityInches() {\n    var gallons = parseFloat(tankGallonsInput.value);\n    if (isNaN(gallons) || gallons <= 0) {\n      return 0;\n    }\n\n    // base : 0,5 po / gallon\n    var base = gallons * 0.5;\n    var factor = 1;\n\n    // type de bac\n    var tankType = getActiveTankType();\n    if (tankType === 'fish-only') {\n      factor = factor * 1.10;\n    } else if (tankType === 'fowlr') {\n      factor = factor * 1.05;\n    }\n\n    // filtration\n    if (filtrationSelect) {\n      var f = filtrationSelect.value;\n      if (f === 'sump') {\n        factor = factor * 1.10;\n      } else if (f === 'aio') {\n        factor = factor * 1.00;\n      } else if (f === 'canister') {\n        factor = factor * 0.95;\n      } else if (f === 'hob') {\n        factor = factor * 0.90;\n      }\n    }\n\n    // refuge\n    if (hasRefugeCheckbox && hasRefugeCheckbox.checked) {\n      factor = factor * 1.05;\n    }\n\n    // roches vivantes : si on est loin de 1 lb/gal, on réduit un peu\n    if (rockLbsInput) {\n      var rockLbs = parseFloat(rockLbsInput.value);\n      if (!isNaN(rockLbs) && rockLbs > 0) {\n        var gallonsVal = gallons;\n        if (gallonsVal > 0) {\n          var ratio = rockLbs / gallonsVal;\n          if (ratio < 0.7) {\n            factor = factor * 0.7;\n          } else if (ratio < 1.0) {\n            factor = factor * 0.9;\n          } else if (ratio > 1.3) {\n            factor = factor * 1.05;\n          }\n        }\n      }\n    }\n\n    return base * factor;\n  }\n\n  // --------- Recalcul principal ---------\n  function rebuildResults() {\n    // on vide le tableau des résultats\n    while (resultTableBody.firstChild) {\n      resultTableBody.removeChild(resultTableBody.firstChild);\n    }\n\n    var qtyInputs      = document.getElementsByClassName('fish-qty-input');\n    var variantSelects = document.getElementsByClassName('fish-variant-select');\n\n    var totalInches = 0;\n    var hasAny      = false;\n\n    // pour chaque input de quantité\n    for (var i = 0; i < qtyInputs.length; i++) {\n      var input = qtyInputs[i];\n      var qty = parseFloat(input.value);\n\n      if (isNaN(qty) || qty <= 0) {\n        continue;\n      }\n\n      hasAny = true;\n\n      var family = input.getAttribute('data-family') || '';\n      var familyLabel = formatFamilyLabel(family);\n\n      // on cherche le select qui correspond à cette famille\n      var select = null;\n      for (var j = 0; j < variantSelects.length; j++) {\n        if (variantSelects[j].getAttribute('data-family') === family) {\n          select = variantSelects[j];\n          break;\n        }\n      }\n\n      var length = getDefaultLengthForFamily(family);\n      var minGallons = '-';\n      var variantName = familyLabel;\n\n      if (select) {\n        var opt = select.options[select.selectedIndex];\n        if (opt) {\n          var optLen = parseFloat(opt.getAttribute('data-length'));\n          if (!isNaN(optLen)) {\n            length = optLen;\n          }\n          var optMin = opt.getAttribute('data-min-gallons');\n          if (optMin) {\n            minGallons = optMin;\n          }\n          if (opt.text) {\n            variantName = opt.text;\n          }\n        }\n      }\n\n      var totalForThis = length * qty;\n      totalInches = totalInches + totalForThis;\n\n      // création de la ligne\n      var tr = document.createElement('tr');\n\n      var tdFamily = document.createElement('td');\n      tdFamily.textContent = familyLabel;\n      tr.appendChild(tdFamily);\n\n      var tdVariant = document.createElement('td');\n      tdVariant.textContent = variantName;\n      tr.appendChild(tdVariant);\n\n      var tdQty = document.createElement('td');\n      tdQty.textContent = qty;\n      tr.appendChild(tdQty);\n\n      var tdLength = document.createElement('td');\n      tdLength.textContent = length.toFixed(1);\n      tr.appendChild(tdLength);\n\n      var tdTotal = document.createElement('td');\n      tdTotal.textContent = totalForThis.toFixed(1);\n      tr.appendChild(tdTotal);\n\n      var tdMin = document.createElement('td');\n      tdMin.textContent = minGallons;\n      tr.appendChild(tdMin);\n\n      resultTableBody.appendChild(tr);\n    }\n\n    // si aucun poisson\n    if (!hasAny) {\n      var emptyRow = document.createElement('tr');\n      emptyRow.className = 'result-table-empty';\n      var tdEmpty = document.createElement('td');\n      tdEmpty.colSpan = 6;\n      tdEmpty.textContent = 'Aucun poisson sélectionné pour le moment.';\n      emptyRow.appendChild(tdEmpty);\n      resultTableBody.appendChild(emptyRow);\n    }\n\n    // capacité et pourcentage\n    var capacity = getAdjustedCapacityInches();\n\n    if (!capacity || capacity <= 0) {\n      if (tankUsageSpan) {\n        tankUsageSpan.textContent = '-';\n      }\n      if (tankUsageBar) {\n        tankUsageBar.style.width = '0%';\n      }\n      if (tankUsageBadge) {\n        tankUsageBadge.className = 'progress-note status-idle';\n        tankUsageBadge.textContent = 'Entrez le volume du bac pour voir la charge.';\n      }\n      if (adviceText) {\n        adviceText.textContent = 'Indiquez le nombre de gallons, la filtration et la roche vivante pour une estimation prudente.';\n      }\n      // possible additions\n      if (possibleSummary && possibleList) {\n        possibleSummary.textContent = 'Une fois le volume saisi et quelques poissons ajoutés, cette section vous proposera des idées de population complémentaire.';\n        possibleList.innerHTML = '';\n        var liInit = document.createElement('li');\n        liInit.textContent = 'Par exemple : 1 petit goby ou 1 cardinal dans un bac encore peu chargé.';\n        possibleList.appendChild(liInit);\n      }\n      return;\n    }\n\n    var percent = 0;\n    if (capacity > 0) {\n      percent = Math.round((totalInches / capacity) * 100);\n    }\n    if (percent < 0) {\n      percent = 0;\n    }\n    if (percent > 200) {\n      percent = 200;\n    }\n\n    if (tankUsageSpan) {\n      tankUsageSpan.textContent =\n        totalInches.toFixed(1) + '\" / ' + capacity.toFixed(1) + '\" (' + percent + '%)';\n    }\n\n    if (tankUsageBar) {\n      tankUsageBar.style.width = percent + '%';\n    }\n\n    if (tankUsageBadge) {\n      if (percent <= 70) {\n        tankUsageBadge.className = 'progress-note status-ok';\n        tankUsageBadge.textContent = 'Zone sécuritaire (estimation prudente).';\n      } else if (percent <= 100) {\n        tankUsageBadge.className = 'progress-note status-warn';\n        tankUsageBadge.textContent = 'Proche de la limite recommandée.';\n      } else {\n        tankUsageBadge.className = 'progress-note status-alert';\n        tankUsageBadge.textContent = 'Au-delà de la limite recommandée.';\n      }\n    }\n\n    if (adviceText) {\n      if (percent <= 70) {\n        adviceText.textContent = 'Votre population semble raisonnable pour ce volume, en supposant une bonne filtration et un entretien régulier.';\n      } else if (percent <= 100) {\n        adviceText.textContent = 'Ajoutez les prochains poissons avec prudence. Surveillez bien les paramètres et la cohabitation.';\n      } else {\n        adviceText.textContent = 'La charge biologique est élevée. Réduire la population ou augmenter le volume / la filtration serait préférable.';\n      }\n    }\n\n    // --------- Bloc \"Ce qu'il serait encore possible d'ajouter\" ----------\n    if (possibleSummary && possibleList) {\n      possibleList.innerHTML = '';\n      var remaining = capacity - totalInches;\n\n      if (remaining <= 0) {\n        possibleSummary.textContent =\n          'Selon ce calcul prudent, votre bac est déjà à sa capacité maximale ou la dépasse légèrement.';\n        var li1 = document.createElement('li');\n        li1.textContent = 'Réduire légèrement la population actuelle serait préférable avant tout ajout.';\n        possibleList.appendChild(li1);\n        var li2 = document.createElement('li');\n        li2.textContent = 'Renforcer la filtration et l’entretien peut aider, mais ne remplace pas un volume adéquat.';\n        possibleList.appendChild(li2);\n      } else {\n        possibleSummary.textContent =\n          'Il reste environ ' + remaining.toFixed(1) + ' pouces de charge biologique disponible selon cette estimation prudente. Idées possibles :';\n\n        var smallLen  = 1.5; // petit goby, clown goby, etc.\n        var mediumLen = 3.0; // cardinal, royal gramma, petit wrasse calme…\n\n        var nbSmall  = Math.floor(remaining / smallLen);\n        var nbMedium = Math.floor(remaining / mediumLen);\n\n        if (nbSmall > 0) {\n          var liSmall = document.createElement('li');\n          liSmall.textContent =\n            'Environ ' + nbSmall + ' petit(s) poisson(s) (~' + smallLen +\n            '\") comme un petit goby (ex. clown goby) si la compatibilité le permet.';\n          possibleList.appendChild(liSmall);\n        }\n\n        if (nbMedium > 0) {\n          var liMed = document.createElement('li');\n          liMed.textContent =\n            'Ou environ ' + nbMedium + ' poisson(s) de taille moyenne (~' + mediumLen +\n            '\"), par exemple un cardinal ou un petit basslet paisible.';\n          possibleList.appendChild(liMed);\n        }\n\n        if (nbSmall <= 0 && nbMedium <= 0) {\n          var liTiny = document.createElement('li');\n          liTiny.textContent =\n            'La marge restante est très faible : au mieux un seul très petit poisson dans un bac très stable.';\n          possibleList.appendChild(liTiny);\n        }\n\n        var liReminder = document.createElement('li');\n        liReminder.textContent =\n          'Toujours tenir compte du tempérament, du territoire et de la compatibilité entre espèces avant tout ajout.';\n        possibleList.appendChild(liReminder);\n      }\n    }\n  }\n\n  // --------- Écouteurs ---------\n  // Type de bac\n  for (var t = 0; t < tankTypeButtons.length; t++) {\n    tankTypeButtons[t].addEventListener('click', function (evt) {\n      for (var u = 0; u < tankTypeButtons.length; u++) {\n        tankTypeButtons[u].className = tankTypeButtons[u].className.replace(' is-active', '');\n      }\n      this.className = this.className + ' is-active';\n      setTankTypeNote();\n      rebuildResults();\n    });\n  }\n\n  // Volume, roche, filtration, refuge\n  tankGallonsInput.addEventListener('input', rebuildResults);\n  if (rockLbsInput) {\n    rockLbsInput.addEventListener('input', rebuildResults);\n  }\n  if (filtrationSelect) {\n    filtrationSelect.addEventListener('change', rebuildResults);\n  }\n  if (hasRefugeCheckbox) {\n    hasRefugeCheckbox.addEventListener('change', rebuildResults);\n  }\n\n  // Poissons : quantités + variantes\n  var qtyInputsInit      = document.getElementsByClassName('fish-qty-input');\n  var variantSelectsInit = document.getElementsByClassName('fish-variant-select');\n\n  for (var q = 0; q < qtyInputsInit.length; q++) {\n    qtyInputsInit[q].addEventListener('input', rebuildResults);\n  }\n  for (var s = 0; s < variantSelectsInit.length; s++) {\n    variantSelectsInit[s].addEventListener('change', rebuildResults);\n  }\n\n  // Texte de type de bac au départ + premier calcul\n  setTankTypeNote();\n  rebuildResults();\n});\n</script>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    },
    "section_custom_liquid_xhBTpC": {
      "type": "section-custom-liquid",
      "name": "Calcul. part 3",
      "settings": {
        "custom_liquid": "<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  var tankInput         = document.getElementById(\"tankGallons\");\n  var tableBody         = document.getElementById(\"resultTableBody\");\n  var usageText         = document.getElementById(\"tankUsage\");\n  var usageBar          = document.getElementById(\"tankUsageBar\");\n  var usageBadge        = document.getElementById(\"tankUsageBadge\");\n  var adviceText        = document.getElementById(\"adviceText\");\n  var possibleSummary   = document.getElementById(\"possibleAdditionsSummary\");\n  var possibleList      = document.getElementById(\"possibleAdditionsList\");\n\n  if (!tankInput || !tableBody) {\n    return;\n  }\n\n  function rebuild() {\n    var tankGallons = parseFloat(tankInput.value);\n    if (isNaN(tankGallons) || tankGallons <= 0) {\n      tankGallons = 0;\n    }\n\n    // règle prudente : 0,5 po de poisson par gallon\n    var maxInches = tankGallons * 0.5;\n\n    var qtyInputs      = document.querySelectorAll(\".fish-qty-input\");\n    var variantSelects = document.querySelectorAll(\".fish-variant-select\");\n\n    var totalInches = 0;\n    var rowsHtml    = \"\";\n\n    // ---------------- TABLEAU PRINCIPAL ----------------\n    qtyInputs.forEach(function (input) {\n      var qty = parseFloat(input.value);\n      if (isNaN(qty) || qty <= 0) {\n        return;\n      }\n\n      var family = input.getAttribute(\"data-family\") || \"\";\n\n      // on cherche le <select> correspondant\n      var select = null;\n      variantSelects.forEach(function (s) {\n        if (s.getAttribute(\"data-family\") === family) {\n          select = s;\n        }\n      });\n\n      var length    = 3;\n      var minGallons = \"-\";\n      var fishName  = family || \"Poisson\";\n\n      if (select) {\n        var opt = select.options[select.selectedIndex];\n        if (opt) {\n          var lenAttr = parseFloat(opt.getAttribute(\"data-length\"));\n          if (!isNaN(lenAttr)) {\n            length = lenAttr;\n          }\n          var minAttr = parseFloat(opt.getAttribute(\"data-min-gallons\"));\n          if (!isNaN(minAttr)) {\n            minGallons = minAttr;\n          }\n          if (opt.textContent) {\n            fishName = opt.textContent.trim();\n          }\n        }\n      }\n\n      var subtotal = length * qty;\n      totalInches += subtotal;\n\n      rowsHtml +=\n        \"<tr>\" +\n          \"<td>\" + (family || \"Poisson\") + \"</td>\" +\n          \"<td>\" + fishName + \"</td>\" +\n          \"<td>\" + qty + \"</td>\" +\n          \"<td>\" + length.toFixed(1) + \"\\\"</td>\" +\n          \"<td>\" + subtotal.toFixed(1) + \"\\\"</td>\" +\n          \"<td>\" + minGallons + (minGallons !== \"-\" ? \" gal\" : \"\") + \"</td>\" +\n        \"</tr>\";\n    });\n\n    if (!rowsHtml) {\n      tableBody.innerHTML =\n        '<tr class=\"result-table-empty\"><td colspan=\"6\">Aucun poisson sélectionné pour le moment.</td></tr>';\n    } else {\n      tableBody.innerHTML = rowsHtml;\n    }\n\n    // ---------------- TAUX D’OCCUPATION ----------------\n    if (!maxInches || maxInches <= 0) {\n      if (usageText) {\n        usageText.textContent = \"-\";\n      }\n      if (usageBar) {\n        usageBar.style.width = \"0%\";\n      }\n      if (usageBadge) {\n        usageBadge.className = \"progress-note status-idle\";\n        usageBadge.textContent = \"Entrez le volume du bac pour voir la charge.\";\n      }\n      if (adviceText) {\n        adviceText.textContent =\n          \"Indiquez le nombre de gallons pour obtenir une estimation prudente de la charge biologique.\";\n      }\n      if (possibleSummary && possibleList) {\n        possibleSummary.textContent =\n          \"Une fois le volume saisi et quelques poissons ajoutés, cette section vous proposera des idées de population complémentaire.\";\n        possibleList.innerHTML =\n          '<li>Par exemple : 1 petit goby ou 1 cardinal dans un bac encore peu chargé.</li>';\n      }\n      return;\n    }\n\n    var usage = (totalInches / maxInches) * 100;\n    if (usage < 0) usage = 0;\n    if (usage > 200) usage = 200;\n\n    if (usageText) {\n      usageText.textContent =\n        totalInches.toFixed(1) + \"\\\" / \" + maxInches.toFixed(1) + \"\\\" (\" + usage.toFixed(0) + \"%)\";\n    }\n    if (usageBar) {\n      usageBar.style.width = usage + \"%\";\n    }\n    if (usageBadge) {\n      if (usage <= 70) {\n        usageBadge.className = \"progress-note status-ok\";\n        usageBadge.textContent = \"Zone sécuritaire (estimation prudente).\";\n      } else if (usage <= 100) {\n        usageBadge.className = \"progress-note status-warn\";\n        usageBadge.textContent = \"Proche de la limite recommandée.\";\n      } else {\n        usageBadge.className = \"progress-note status-alert\";\n        usageBadge.textContent = \"Au-delà de la limite recommandée.\";\n      }\n    }\n    if (adviceText) {\n      if (usage <= 70) {\n        adviceText.textContent =\n          \"Votre population semble raisonnable pour ce volume, en supposant une bonne filtration et un entretien régulier.\";\n      } else if (usage <= 100) {\n        adviceText.textContent =\n          \"Ajoutez les prochains poissons avec prudence. Surveillez bien les paramètres et la cohabitation.\";\n      } else {\n        adviceText.textContent =\n          \"La charge biologique est élevée. Réduire la population ou augmenter le volume / la filtration serait préférable.\";\n      }\n    }\n\n    // ---------------- SUGGESTIONS AVEC LIENS D’ACHAT ----------------\n    if (!possibleSummary || !possibleList) {\n      return;\n    }\n\n    var remaining = maxInches - totalInches;\n\n    if (remaining <= 0) {\n      possibleSummary.textContent =\n        \"Selon ce calcul prudent, votre bac est déjà à sa capacité maximale ou la dépasse légèrement.\";\n      possibleList.innerHTML = \"\";\n      var li1 = document.createElement(\"li\");\n      li1.textContent = \"Réduire légèrement la population actuelle serait préférable avant tout ajout.\";\n      possibleList.appendChild(li1);\n      var li2 = document.createElement(\"li\");\n      li2.textContent = \"Renforcer la filtration et l’entretien peut aider, mais ne remplace pas un volume adéquat.\";\n      possibleList.appendChild(li2);\n      return;\n    }\n\n    possibleSummary.textContent =\n      \"Voici quelques poissons compatibles qui pourraient encore être ajoutés sans dépasser la charge biologique ni le volume minimal requis :\";\n\n    // on parcourt TOUTES les variantes possibles\n    var allOptions = document.querySelectorAll(\".fish-variant-select option\");\n    var suggestions = [];\n\n    allOptions.forEach(function (opt) {\n      var name       = (opt.textContent || \"\").trim();\n      var lenAttr    = parseFloat(opt.getAttribute(\"data-length\"));\n      var minAttr    = parseFloat(opt.getAttribute(\"data-min-gallons\"));\n      var productUrl = opt.getAttribute(\"data-product-url\");\n\n      if (!name || !productUrl) {\n        return;\n      }\n      if (isNaN(lenAttr) || lenAttr <= 0) {\n        return;\n      }\n      // si le min gallons n’est pas lisible, on préfère NE PAS suggérer\n      if (isNaN(minAttr) || minAttr <= 0) {\n        return;\n      }\n\n      // 🔐 on filtre :\n      // - longueur <= pouces restants\n      // - volume minimal du poisson <= volume réel du bac\n      if (lenAttr <= remaining && minAttr <= tankGallons) {\n        suggestions.push({\n          name: name,\n          url: productUrl\n        });\n      }\n    });\n\n    if (suggestions.length === 0) {\n      possibleList.innerHTML = \"\";\n      var liNone = document.createElement(\"li\");\n      liNone.textContent =\n        \"Avec ce volume et cette charge actuelle, aucun ajout précis n’est recommandé. Vous êtes proche de la limite sécuritaire.\";\n      possibleList.appendChild(liNone);\n      return;\n    }\n\n    // on limite pour ne pas surcharger la liste\n    var maxSuggestions = 8;\n    var limited = suggestions.slice(0, maxSuggestions);\n\n    possibleList.innerHTML = \"\";\n    limited.forEach(function (s) {\n      var li = document.createElement(\"li\");\n      var a  = document.createElement(\"a\");\n      a.href = s.url;\n      a.target = \"_blank\";\n      a.textContent = s.name;\n      a.style.color = \"#0077c2\";\n      li.appendChild(a);\n      possibleList.appendChild(li);\n    });\n\n    // petit rappel général\n    var liRem = document.createElement(\"li\");\n    liRem.textContent =\n      \"Toujours tenir compte du tempérament, du territoire et de la compatibilité entre espèces avant tout ajout.\";\n    possibleList.appendChild(liRem);\n  }\n\n  // écouteurs\n  var allInputs = document.querySelectorAll(\"input, select\");\n  allInputs.forEach(function (el) {\n    el.addEventListener(\"input\", rebuild);\n    el.addEventListener(\"change\", rebuild);\n  });\n\n  // premier calcul\n  rebuild();\n});\n</script>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    }
  },
  "order": [
    "breadcrumbs",
