      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<div id=\"aquacorail-sand-calculator\" style=\"max-width:900px;margin:0 auto;padding:30px 15px;font-family:inherit;\">\n  <style>\n    #aquacorail-sand-calculator * {\n      box-sizing: border-box;\n    }\n\n    #aquacorail-sand-calculator h2 {\n      font-size: 28px;\n      margin-bottom: 8px;\n      text-align: center;\n    }\n\n    #aquacorail-sand-calculator p.subtext {\n      font-size: 14px;\n      color: #1f2937;\n      text-align: center;\n      margin-bottom: 20px;\n      line-height: 1.5;\n      font-weight: 500;\n    }\n\n    #aquacorail-sand-calculator .ac-card {\n      background: #f8fafc;\n      border-radius: 10px;\n      padding: 20px;\n      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);\n      border: 1px solid #e2e8f0;\n    }\n\n    #aquacorail-sand-calculator .ac-section-title {\n      font-weight: 600;\n      margin-bottom: 10px;\n      font-size: 13px;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      color: #475569;\n    }\n\n    /* Onglets forme du bac */\n    #aquacorail-sand-calculator .ac-tabs {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 16px;\n      flex-wrap: wrap;\n    }\n\n    #aquacorail-sand-calculator .ac-tab {\n      padding: 6px 12px;\n      border-radius: 999px;\n      border: 1px solid #cbd5f5;\n      background: #e5edff;\n      font-size: 13px;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      user-select: none;\n      white-space: nowrap;\n      flex: 0 0 auto;\n    }\n\n    #aquacorail-sand-calculator .ac-tab.ac-active {\n      background: #1d4ed8;\n      color: #fff;\n      border-color: #1d4ed8;\n      box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.4);\n    }\n\n    /* Grille des champs */\n    #aquacorail-sand-calculator .ac-form-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n      gap: 12px 16px;\n      margin-bottom: 12px;\n    }\n\n    #aquacorail-sand-calculator label {\n      font-size: 13px;\n      font-weight: 600;\n      display: block;\n      margin-bottom: 4px;\n      color: #0f172a;\n    }\n\n    #aquacorail-sand-calculator .ac-input,\n    #aquacorail-sand-calculator .ac-select {\n      width: 100%;\n      padding: 8px 10px;\n      border-radius: 8px;\n      border: 1px solid #cbd5e1;\n      background: #fff;\n      font-size: 14px;\n      outline: none;\n      transition: border-color 0.2s ease, box-shadow 0.2s ease;\n    }\n\n    #aquacorail-sand-calculator .ac-input:focus,\n    #aquacorail-sand-calculator .ac-select:focus {\n      border-color: #1d4ed8;\n      box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.2);\n    }\n\n    /* Bloc unités (cm / pouces) */\n    #aquacorail-sand-calculator .ac-unit-toggle {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 13px;\n      margin-bottom: 14px;\n      flex-wrap: wrap;\n    }\n\n    #aquacorail-sand-calculator .ac-unit-toggle span {\n      white-space: nowrap;\n    }\n\n    #aquacorail-sand-calculator .ac-pill-toggle {\n      display: inline-flex;\n      gap: 6px;\n      background: transparent;\n      border: none;\n      padding: 0;\n    }\n\n    #aquacorail-sand-calculator .ac-pill-toggle button {\n      all: unset;\n      display: inline-block;\n      padding: 6px 12px;\n      font-size: 12px;\n      line-height: 1.4;\n      border-radius: 999px;\n      border: 1px solid #cbd5e1;\n      background: #ffffff;\n      color: #111827;\n      cursor: pointer;\n      font-weight: 500;\n    }\n\n    #aquacorail-sand-calculator .ac-pill-toggle button.ac-active {\n      background: #1d4ed8;\n      border-color: #1d4ed8;\n      color: #ffffff;\n    }\n\n    #aquacorail-sand-calculator .ac-helper-text {\n      font-size: 12px;\n      color: #64748b;\n      margin-top: 4px;\n    }\n\n    /* Résultats */\n    #aquacorail-sand-calculator .ac-result-card {\n      margin-top: 18px;\n      padding: 16px;\n      border-radius: 10px;\n      background: #0f172a;\n      color: #e5e7eb;\n    }\n\n    #aquacorail-sand-calculator .ac-result-title {\n      font-size: 15px;\n      font-weight: 600;\n      margin-bottom: 8px;\n    }\n\n    #aquacorail-sand-calculator .ac-result-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n      gap: 10px;\n      font-size: 13px;\n      margin-bottom: 12px;\n    }\n\n    #aquacorail-sand-calculator .ac-result-item span.label {\n      display: block;\n      color: #9ca3af;\n      font-size: 12px;\n      margin-bottom: 2px;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n    }\n\n    #aquacorail-sand-calculator .ac-result-item span.value {\n      font-weight: 600;\n      font-size: 14px;\n    }\n\n    #aquacorail-sand-calculator .ac-note {\n      font-size: 12px;\n      color: #6b7280;\n      margin-top: 10px;\n      line-height: 1.4;\n    }\n\n    #aquacorail-sand-calculator .ac-note strong {\n      color: #0f172a;\n    }\n\n    @media (max-width: 600px) {\n      #aquacorail-sand-calculator {\n        padding: 20px 10px;\n      }\n\n      #aquacorail-sand-calculator h2 {\n        font-size: 22px;\n      }\n    }\n  </style>\n\n  <h2>Calculateur de sable AquaCorail</h2>\n  <p class=\"subtext\">\n    Entrez les dimensions de votre aquarium et la profondeur de sable souhaitée. Nous vous indiquerons\n    le volume, le poids approximatif et le nombre de sacs recommandés.\n  </p>\n\n  <div class=\"ac-card\">\n    <div class=\"ac-section-title\">Forme de l’aquarium</div>\n    <div class=\"ac-tabs\">\n      <div class=\"ac-tab ac-active\" data-shape=\"rectangle\">Rectangulaire / cube</div>\n      <div class=\"ac-tab\" data-shape=\"cylinder\">Cylindrique (rond)</div>\n    </div>\n\n    <div class=\"ac-unit-toggle\">\n      <span>Unités des mesures :</span>\n      <div class=\"ac-pill-toggle\">\n        <button type=\"button\" data-unit=\"cm\">Centimètres</button>\n        <button type=\"button\" class=\"ac-active\" data-unit=\"in\">Pouces</button>\n      </div>\n    </div>\n\n    <!-- Forme rectangulaire -->\n    <div id=\"ac-shape-rectangle\">\n      <div class=\"ac-form-grid\">\n        <div>\n          <label for=\"ac-length-rect\">Longueur de l’aquarium</label>\n          <input type=\"number\" id=\"ac-length-rect\" class=\"ac-input\" min=\"0\" step=\"any\" placeholder=\"ex. 36\">\n          <div class=\"ac-helper-text\">Mesurée à l’intérieur du verre</div>\n        </div>\n        <div>\n          <label for=\"ac-width-rect\">Largeur de l’aquarium</label>\n          <input type=\"number\" id=\"ac-width-rect\" class=\"ac-input\" min=\"0\" step=\"any\" placeholder=\"ex. 18\">\n        </div>\n        <div>\n          <label for=\"ac-depth-rect\">Profondeur du sable souhaitée</label>\n          <input type=\"number\" id=\"ac-depth-rect\" class=\"ac-input\" min=\"0\" step=\"any\" placeholder=\"ex. 2\">\n          <div class=\"ac-helper-text\">AquaCorail recommande généralement 1 à 2\" (2,5 à 5 cm)</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Forme cylindrique -->\n    <div id=\"ac-shape-cylinder\" style=\"display:none;\">\n      <div class=\"ac-form-grid\">\n        <div>\n          <label for=\"ac-diameter-cyl\">Diamètre intérieur</label>\n          <input type=\"number\" id=\"ac-diameter-cyl\" class=\"ac-input\" min=\"0\" step=\"any\" placeholder=\"ex. 16\">\n        </div>\n        <div>\n          <label for=\"ac-depth-cyl\">Profondeur du sable souhaitée</label>\n          <input type=\"number\" id=\"ac-depth-cyl\" class=\"ac-input\" min=\"0\" step=\"any\" placeholder=\"ex. 2\">\n          <div class=\"ac-helper-text\">Ajustez selon les poissons fouisseurs ou gobies</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ac-section-title\" style=\"margin-top:16px;\">Type de sable</div>\n    <div class=\"ac-form-grid\">\n      <div>\n        <label for=\"ac-sand-type\">Sable AquaCorail / CaribSea</label>\n        <select id=\"ac-sand-type\" class=\"ac-select\">\n          <option value=\"generic\">Sable aragonite (générique)</option>\n          <option value=\"ocean-direct-oolite\">Ocean Direct – Sable Vivant Oolite</option>\n          <option value=\"fiji\">CaribSea Arag-Alive Fiji Pink</option>\n          <option value=\"special\">CaribSea Special Grade</option>\n          <option value=\"bahamas\">CaribSea Bahamas Oolite</option>\n          <option value=\"hawaiian-black\">CaribSea Hawaiian Black</option>\n          <option value=\"indo-black\">CaribSea Indo-Pacific Black</option>\n          <option value=\"bimini\">CaribSea Bimini Pink</option>\n          <option value=\"natural-reef\">CaribSea Natural Reef</option>\n          <option value=\"florida-crushed\">Florida Crushed Coral</option>\n        </select>\n        <div class=\"ac-helper-text\">\n          Le calcul de poids utilise une densité moyenne d’aragonite. Les besoins réels peuvent varier légèrement selon le produit.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ac-result-card\" id=\"ac-sand-result\" style=\"display:none;\">\n      <div class=\"ac-result-title\">Résultats estimés</div>\n      <div class=\"ac-result-grid\">\n        <div class=\"ac-result-item\">\n          <span class=\"label\">Volume de sable</span>\n          <span class=\"value\" id=\"ac-result-volume\"></span>\n        </div>\n        <div class=\"ac-result-item\">\n          <span class=\"label\">Poids estimé</span>\n          <span class=\"value\" id=\"ac-result-weight\"></span>\n        </div>\n        <div class=\"ac-result-item\">\n          <span class=\"label\">Sacs de ~20&nbsp;lb (≈9&nbsp;kg)</span>\n          <span class=\"value\" id=\"ac-result-bags\"></span>\n        </div>\n        <!-- NOUVELLE LIGNE PRODUIT RECOMMANDÉ -->\n        <div class=\"ac-result-item\" id=\"ac-result-product-row\" style=\"display:none;\">\n          <span class=\"label\">Produit recommandé</span>\n          <span class=\"value\">\n            <a href=\"#\" id=\"ac-result-product-link\" target=\"_blank\" style=\"text-decoration:underline;color:#bfdbfe;\">\n              Acheter ce produit\n            </a>\n          </span>\n        </div>\n      </div>\n\n      <div class=\"ac-note\">\n        <strong>Note :</strong> il est souvent préférable de prévoir légèrement plus de sable que le minimum calculé, surtout si vous aimez\n        un lit de sable plus épais à l’avant ou des zones plus profondes pour certains poissons.\n      </div>\n    </div>\n\n    <div class=\"ac-note\">\n      Ce calculateur fournit une estimation basée sur une densité moyenne de sable aragonite sec (~1,4&nbsp;kg/L).\n      Les résultats peuvent varier en fonction de la marque, de la granulométrie et de l’emballage.\n    </div>\n  </div>\n\n  <script>\n    (function() {\n      var container = document.getElementById('aquacorail-sand-calculator');\n      if (!container) return;\n\n      var activeShape = 'rectangle';\n      var activeUnit = 'in'; // PAR DÉFAUT EN POUCES\n\n      var tabs = container.querySelectorAll('.ac-tab');\n      var unitButtons = container.querySelectorAll('.ac-pill-toggle button');\n\n      var rectSection = document.getElementById('ac-shape-rectangle');\n      var cylSection = document.getElementById('ac-shape-cylinder');\n\n      var sandTypeSelect = document.getElementById('ac-sand-type');\n\n      var resultCard = document.getElementById('ac-sand-result');\n      var resultVolume = document.getElementById('ac-result-volume');\n      var resultWeight = document.getElementById('ac-result-weight');\n      var resultBags = document.getElementById('ac-result-bags');\n\n      // Nouvelle ligne \"Produit recommandé\"\n      var resultProductRow = document.getElementById('ac-result-product-row');\n      var resultProductLink = document.getElementById('ac-result-product-link');\n\n      // Densité moyenne estimée pour sable aragonite sec\n      var densityKgPerL = 1.4;\n\n      // Associe chaque option à un produit (AquaCorail)\n      var sandProducts = {\n        'ocean-direct-oolite': {\n          name: 'Ocean Direct – Sable Vivant Oolite',\n          url: 'https://aquacorail.ca/products/ocean-direct-sable-vivant-oolite?_pos=1&_sid=27844ceae&_ss=r'\n        },\n        'generic': {\n          name: 'Sable aragonite (générique)',\n          url: ''\n        },\n        'fiji': {\n          name: 'CaribSea Arag-Alive Fiji Pink',\n          url: ''\n        },\n        'special': {\n          name: 'CaribSea Special Grade',\n          url: ''\n        },\n        'bahamas': {\n          name: 'CaribSea Bahamas Oolite',\n          url: ''\n        },\n        'hawaiian-black': {\n          name: 'CaribSea Hawaiian Black',\n          url: ''\n        },\n        'indo-black': {\n          name: 'CaribSea Indo-Pacific Black',\n          url: ''\n        },\n        'bimini': {\n          name: 'CaribSea Bimini Pink',\n          url: ''\n        },\n        'natural-reef': {\n          name: 'CaribSea Natural Reef',\n          url: ''\n        },\n        'florida-crushed': {\n          name: 'Florida Crushed Coral',\n          url: ''\n        }\n      };\n\n      function setShape(shape) {\n        activeShape = shape;\n        tabs.forEach(function(tab) {\n          tab.classList.toggle('ac-active', tab.getAttribute('data-shape') === shape);\n        });\n        if (shape === 'rectangle') {\n          rectSection.style.display = '';\n          cylSection.style.display = 'none';\n        } else {\n          rectSection.style.display = 'none';\n          cylSection.style.display = '';\n        }\n        updateResults();\n      }\n\n      function setUnit(unit) {\n        activeUnit = unit;\n        unitButtons.forEach(function(btn) {\n          btn.classList.toggle('ac-active', btn.getAttribute('data-unit') === unit);\n        });\n        updateResults();\n      }\n\n      function toCm(value) {\n        var v = parseFloat(value);\n        if (isNaN(v) || v <= 0) return null;\n        if (activeUnit === 'cm') return v;\n        // pouce -> cm\n        return v * 2.54;\n      }\n\n      function computeVolumeLiters() {\n        var volumeCm3 = 0;\n\n        if (activeShape === 'rectangle') {\n          var L = toCm(document.getElementById('ac-length-rect').value);\n          var W = toCm(document.getElementById('ac-width-rect').value);\n          var D = toCm(document.getElementById('ac-depth-rect').value);\n          if (!L || !W || !D) return null;\n          volumeCm3 = L * W * D;\n        } else {\n          var dia = toCm(document.getElementById('ac-diameter-cyl').value);\n          var depth = toCm(document.getElementById('ac-depth-cyl').value);\n          if (!dia || !depth) return null;\n          var radius = dia / 2;\n          volumeCm3 = Math.PI * radius * radius * depth;\n        }\n\n        if (!volumeCm3 || volumeCm3 <= 0) return null;\n        return volumeCm3 / 1000; // cm3 -> L\n      }\n\n      function updateProductLink() {\n        var currentType = sandTypeSelect.value;\n        var config = sandProducts[currentType];\n\n        if (!config || !config.url) {\n          resultProductRow.style.display = 'none';\n          return;\n        }\n\n        resultProductLink.href = config.url;\n        resultProductRow.style.display = '';\n      }\n\n      function updateResults() {\n        var volL = computeVolumeLiters();\n        if (!volL) {\n          resultCard.style.display = 'none';\n          resultProductRow.style.display = 'none';\n          return;\n        }\n\n        // Poids estimé\n        var weightKg = volL * densityKgPerL;\n        var weightLb = weightKg * 2.20462;\n\n        // Nombre de sacs ~20 lb (≈9 kg)\n        var bagKg = 9.07;\n        var bags = weightKg / bagKg;\n        var bagsRounded = Math.ceil(bags * 10) / 10;\n\n        resultVolume.textContent = volL.toFixed(1) + ' L';\n        resultWeight.textContent = weightKg.toFixed(1) + ' kg (' + weightLb.toFixed(1) + ' lb)';\n        resultBags.textContent = bagsRounded.toFixed(1) + ' sac(s)';\n\n        resultCard.style.display = '';\n\n        // Met à jour le lien \"Acheter ce produit\"\n        updateProductLink();\n      }\n\n      // Listeners\n      tabs.forEach(function(tab) {\n        tab.addEventListener('click', function() {\n          setShape(tab.getAttribute('data-shape'));\n        });\n      });\n\n      unitButtons.forEach(function(btn) {\n        btn.addEventListener('click', function() {\n          setUnit(btn.getAttribute('data-unit'));\n        });\n      });\n\n      container.querySelectorAll('.ac-input, .ac-select').forEach(function(el) {\n        el.addEventListener('input', updateResults);\n        el.addEventListener('change', updateResults);\n      });\n\n      sandTypeSelect.addEventListener('change', function() {\n        updateResults();\n      });\n\n      // Initial calculation\n      updateResults();\n    })();\n  </script>\n</div>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    }
