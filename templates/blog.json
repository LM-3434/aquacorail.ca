{"sections":{"breadcrumbs":{"type":"breadcrumbs","settings":{"hide_mobile":false}},"1655209702a1c75d2c":{"type":"section-slideshow","blocks":{"1655209702b314cdd2-0":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/7bf20f8f-23d6-4ae1-9417-62537865172b_fb6fe9a6-6f5d-4c20-9207-d24b3a9b7b6a.jpg","layout":"background","overlay_opacity":55,"color_palette":"scheme-4","text_position":"align-center text-center","title":"<h1>Références et conseils<\/h1>","title_underline_style":"none","text":"<p>Apprendre, comprendre et réussir votre aquarium<\/p>","show_first_link":false,"first_link_text":"Button","first_link_url":"\/","first_button_style":"primary plain","show_second_link":false,"second_link_text":"Button","second_link_url":"","second_button_style":"secondary plain","show_overlay_link":true,"overlay_url":""}}},"block_order":["1655209702b314cdd2-0"],"settings":{"height":"32\/9","width":"boxed","autoplay":false,"autoplay_seconds":3,"enable_controls":false,"height_mobile":"xs","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"main-blog":{"type":"main-blog","disabled":true,"name":"Publications","settings":{"title_size":"h1","title":"","show_tags":false,"pagination_qty":15,"blog_title_size":"h4","show_image":true,"show_date":true,"show_author":true,"show_excerpt":false,"button_style_post":"primary link"}},"section_blog_posts_kwnDay":{"type":"section-blog-posts","name":"Procédures d'acclimatation","settings":{"blog":"news","number_of_items":3,"text_alignment":"start","title":"<h1><strong>Procédures d'acclimatation<\/strong><\/h1>","title_underline_style":"none","show_link":true,"link_text":"Button","link_url":"","button_style":"primary link","blog_title_size":"h4","show_image":true,"show_date":true,"show_author":true,"show_excerpt":false,"button_style_post":"primary link","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"section_custom_liquid_bbmLt8":{"type":"section-custom-liquid","name":"Calculateur salinité","settings":{"custom_liquid":"<div id=\"salt-calculator\" style=\"max-width:650px;margin:0 auto;padding:20px;\">\n  <h2 style=\"font-size:24px;margin-bottom:10px;\">Calculateur de sel AquaCorail<\/h2>\n  <p style=\"margin-bottom:20px;font-size:14px;line-height:1.5;\">\n    Entrez vos paramètres. Les résultats s'affichent automatiquement ci-dessous.\n  <\/p>\n\n  <style>\n    #salt-calculator input,\n    #salt-calculator select {\n      width: 100% !important;\n      max-width: 100% !important;\n      box-sizing: border-box !important;\n    }\n\n    #salt-calculator .volume-row {\n      display: flex;\n      gap: 10px;\n      width: 100%;\n    }\n\n    #salt-calculator .volume-row > input {\n      flex: 1;\n    }\n\n    #salt-calculator .volume-row > select {\n      width: 140px !important;\n      flex-shrink: 0;\n    }\n\n    #salt-calculator-result-bar {\n      margin-top: 20px;\n      padding: 12px 15px;\n      border-radius: 4px;\n      background: #222;\n      color: #fff;\n      font-size: 15px;\n      line-height: 1.4;\n      font-weight: 500;\n    }\n  <\/style>\n\n  <div style=\"display:flex;flex-direction:column;gap:12px;margin-bottom:10px;\">\n\n    <label>\n      <span>Sel utilisé<\/span><br>\n      <select id=\"saltMix\" style=\"padding:8px;\">\n        <option value=\"red_sea_coral_pro\">Red Sea Coral Pro<\/option>\n        <option value=\"red_sea_blue\">Red Sea Blue Bucket<\/option>\n        <option value=\"reef_crystals\">Instant Ocean Reef Crystals<\/option>\n        <option value=\"seapora_balanced\">Seapora Balanced Pro Reef<\/option>\n        <option value=\"seapora_sea_salt\">Seapora Sea Salt<\/option>\n      <\/select>\n    <\/label>\n\n    <label>\n      <span>Volume d'eau<\/span><br>\n      <div class=\"volume-row\">\n        <input id=\"waterVolume\" type=\"number\" min=\"0\" step=\"0.1\" placeholder=\"Ex: 5\">\n        <select id=\"volumeUnit\">\n          <option value=\"gallons\">Gallons US<\/option>\n          <option value=\"liters\">Litres<\/option>\n        <\/select>\n      <\/div>\n    <\/label>\n\n    <label>\n      <span>Salinité actuelle (ppt)<\/span><br>\n      <input id=\"currentSalinity\" type=\"number\" min=\"0\" max=\"50\" step=\"0.1\" placeholder=\"Ex: 0\">\n    <\/label>\n\n    <label>\n      <span>Salinité désirée (ppt)<\/span><br>\n      <input id=\"targetSalinity\" type=\"number\" min=\"0\" max=\"50\" step=\"0.1\" placeholder=\"Ex: 35\">\n    <\/label>\n  <\/div>\n\n  <div id=\"salt-calculator-result-bar\">\n    <span id=\"saltResultText\">Entrez des valeurs pour obtenir le résultat.<\/span>\n  <\/div>\n<\/div>\n\n<script>\n  (function() {\n    const LITERS_PER_GALLON = 3.78541;\n\n    const saltMixes = {\n      red_sea_coral_pro: { name: \"Red Sea Coral Pro\", gramsPerLiter35ppt: 38.1 },\n      red_sea_blue:      { name: \"Red Sea Blue Bucket\", gramsPerLiter35ppt: 38.1 },\n      reef_crystals:     { name: \"Instant Ocean Reef Crystals\", gramsPerLiter35ppt: 39.5 },\n      seapora_balanced:  { name: \"Seapora Balanced Pro Reef\", gramsPerLiter35ppt: 38.5 },\n      seapora_sea_salt:  { name: \"Seapora Sea Salt\", gramsPerLiter35ppt: 38.5 }\n    };\n\n    function convertVolumeToLiters(volume, unit) {\n      return unit === \"gallons\" ? volume * LITERS_PER_GALLON : volume;\n    }\n\n    function calculateSaltNeededGrams(volumeLiters, currentPPT, targetPPT, gPerL) {\n      if (targetPPT <= currentPPT) return 0;\n      const delta = targetPPT - currentPPT;\n      const factor = delta \/ 35;\n      return volumeLiters * (gPerL * factor);\n    }\n\n    function setupCalculator() {\n      const saltSelect   = document.getElementById(\"saltMix\");\n      const volumeInput  = document.getElementById(\"waterVolume\");\n      const unitSelect   = document.getElementById(\"volumeUnit\");\n      const currentInput = document.getElementById(\"currentSalinity\");\n      const targetInput  = document.getElementById(\"targetSalinity\");\n      const resultText   = document.getElementById(\"saltResultText\");\n\n      function updateResult() {\n        const saltKey = saltSelect.value;\n        const volume  = parseFloat(volumeInput.value);\n        const unit    = unitSelect.value;\n        const current = parseFloat(currentInput.value);\n        const target  = parseFloat(targetInput.value);\n\n        const mix = saltMixes[saltKey];\n\n        if (!mix || isNaN(volume) || volume <= 0 || isNaN(current) || isNaN(target)) {\n          resultText.textContent = \"Entrez des valeurs valides pour obtenir le résultat.\";\n          return;\n        }\n\n        const volumeLiters = convertVolumeToLiters(volume, unit);\n        const gramsNeeded  = calculateSaltNeededGrams(\n          volumeLiters, current, target, mix.gramsPerLiter35ppt\n        );\n\n        if (gramsNeeded <= 0) {\n          resultText.textContent = \"Aucun sel requis pour atteindre la cible.\";\n          return;\n        }\n\n        const pounds = gramsNeeded \/ 453.59;\n\n        resultText.innerHTML =\n          \"RÉSULTAT : ~<strong>\" + pounds.toFixed(2) + \" lb<\/strong> (\" +\n          Math.round(gramsNeeded) + \" g) requis pour atteindre <strong>\" +\n          target + \" ppt<\/strong>\";\n      }\n\n      [\"input\", \"change\"].forEach(evt => {\n        saltSelect.addEventListener(evt, updateResult);\n        volumeInput.addEventListener(evt, updateResult);\n        unitSelect.addEventListener(evt, updateResult);\n        currentInput.addEventListener(evt, updateResult);\n        targetInput.addEventListener(evt, updateResult);\n      });\n\n      updateResult();\n    }\n\n    setupCalculator();\n  })();\n<\/script>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}}},"order":["breadcrumbs","1655209702a1c75d2c","main-blog","section_blog_posts_kwnDay","section_custom_liquid_bbmLt8"]}