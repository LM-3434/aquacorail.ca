{"sections":{"breadcrumbs":{"type":"breadcrumbs","settings":{"hide_mobile":false}},"main-page":{"type":"main-page","blocks":{"title":{"type":"title","name":"Calculateur","settings":{"title_size":"h1"}},"content":{"type":"content","disabled":true,"settings":{}}},"block_order":["title","content"],"settings":{"max_width":980,"content_alignment":"start","text_alignment":"start","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}},"section_custom_liquid_MzyFdT":{"type":"section-custom-liquid","name":"t:sections.custom_liquid.presets.name","settings":{"custom_liquid":"<!-- SECTION : Calculateur de volume d’aquarium -->\n<section id=\"calculator-volume\" style=\"max-width:600px;margin:0 auto;\">\n  <h2>Calculateur de volume d’aquarium<\/h2>\n  <p>Entrez les dimensions de votre aquarium en pouces. Le calcul se fait automatiquement.<\/p>\n\n  <div id=\"form-volume\" style=\"display:flex;flex-direction:column;gap:12px;\">\n    <label for=\"length\">Longueur (po) :<\/label>\n    <input type=\"number\" id=\"length\" min=\"0\" step=\"any\" \/>\n\n    <label for=\"width\">Largeur (po) :<\/label>\n    <input type=\"number\" id=\"width\" min=\"0\" step=\"any\" \/>\n\n    <label for=\"height\">Hauteur (po) :<\/label>\n    <input type=\"number\" id=\"height\" min=\"0\" step=\"any\" \/>\n\n    <label for=\"unit\">Unité de résultat :<\/label>\n    <select id=\"unit\">\n      <option value=\"litres\">Litres<\/option>\n      <option value=\"gallons\">Gallons (US)<\/option>\n    <\/select>\n\n    <div id=\"result\" style=\"margin-top:15px;font-size:18px;\">\n      <p>Volume estimé : <span id=\"volumeValue\">-<\/span><\/p>\n    <\/div>\n  <\/div>\n<\/section>\n\n<script>\nfunction calculateVolume() {\n  const length = parseFloat(document.getElementById('length').value);\n  const width  = parseFloat(document.getElementById('width').value);\n  const height = parseFloat(document.getElementById('height').value);\n  const unitEl = document.getElementById('unit');\n  if (!unitEl) return;\n  const unit   = unitEl.value;\n\n  \/\/ Vérifie que tout est rempli et numérique\n  if (isNaN(length) || isNaN(width) || isNaN(height) || length <= 0 || width <= 0 || height <= 0) {\n    document.getElementById('volumeValue').textContent = \"-\";\n    return;\n  }\n\n  \/\/ Volume en pouces cubes (in³)\n  const volumeIn3 = length * width * height;\n\n  \/\/ Conversion pouces cubes → litres (1 in³ = 0.0163871 L)\n  const volumeLitres = volumeIn3 * 0.0163871;\n\n  let result = '';\n  if (unit === 'litres') {\n    result = volumeLitres.toFixed(2) + ' L';\n  } else {\n    \/\/ Gallons US (1 gallon = 3.78541 L)\n    const volumeGallons = volumeLitres \/ 3.78541;\n    result = volumeGallons.toFixed(2) + ' gal (US)';\n  }\n\n  document.getElementById('volumeValue').textContent = result;\n}\n\ndocument.addEventListener('DOMContentLoaded', function() {\n  const lengthInput = document.getElementById('length');\n  const widthInput  = document.getElementById('width');\n  const heightInput = document.getElementById('height');\n  const unitSelect  = document.getElementById('unit');\n\n  if (lengthInput) lengthInput.addEventListener('input', calculateVolume);\n  if (widthInput)  widthInput.addEventListener('input', calculateVolume);\n  if (heightInput) heightInput.addEventListener('input', calculateVolume);\n  if (unitSelect)  unitSelect.addEventListener('change', calculateVolume);\n});\n<\/script>","spacing_desktop":50,"spacing_mobile":30,"fix_zindex":0}}},"order":["breadcrumbs","main-page","section_custom_liquid_MzyFdT"]}