  window.fishCalc = window.fishCalc || {};

  // Calcule la somme totale en pouces de poissons
  function calculerTotalPouces() {
    var total = 0;
    var qtyInputs = document.querySelectorAll('.fish-qty-input');

    qtyInputs.forEach(function(input) {
      var qty = parseInt(input.value, 10) || 0;
      var family = input.getAttribute('data-family');
      var select = document.querySelector('.fish-variant-select[data-family="' + family + '"]');
      if (!family || !select || !fishConfig[family]) return;

      var variantKey = select.value;
      var variantConf = fishConfig[family].variants[variantKey];
      if (!variantConf) return;

      total += qty * variantConf.lengthInches;
    });

    window.fishCalc.totalInches = total;
    return total;
  }

  function mettreAJourTableauResultats() {
    var tbody = document.getElementById('resultTableBody');
    if (!tbody) return;

    tbody.innerHTML = '';
    var qtyInputs = document.querySelectorAll('.fish-qty-input');
    var any = false;

    qtyInputs.forEach(function(input) {
      var qty = parseInt(input.value, 10) || 0;
      if (!qty || qty <= 0) return;

      var family = input.getAttribute('data-family');
      var select = document.querySelector('.fish-variant-select[data-family="' + family + '"]');
      if (!family || !select || !fishConfig[family]) return;

      var variantKey = select.value;
      var variantConf = fishConfig[family].variants[variantKey];
      if (!variantConf) return;

      any = true;
      var lengthInches = variantConf.lengthInches || 0;
      var minGallons = variantConf.minGallons || 0;
      var totalInches = qty * lengthInches;

      var tr = document.createElement('tr');

      var tdFamily = document.createElement('td');
      tdFamily.textContent = familyLabels[family] || family;
      tr.appendChild(tdFamily);

      var tdVariant = document.createElement('td');
      tdVariant.textContent = select.options[select.selectedIndex].text;
      tr.appendChild(tdVariant);

      var tdQty = document.createElement('td');
      tdQty.textContent = qty;
      tr.appendChild(tdQty);

      var tdLen = document.createElement('td');
      tdLen.textContent = lengthInches.toFixed(1);
      tr.appendChild(tdLen);

      var tdTotal = document.createElement('td');
      tdTotal.textContent = totalInches.toFixed(1);
      tr.appendChild(tdTotal);

      var tdGallons = document.createElement('td');
      tdGallons.textContent = minGallons > 0 ? (minGallons + " gal min.") : "-";
      tr.appendChild(tdGallons);

      tbody.appendChild(tr);
    });

    if (!any) {
      var trEmpty = document.createElement('tr');
      trEmpty.className = 'result-table-empty';
      var tdEmpty = document.createElement('td');
      tdEmpty.colSpan = 6;
      tdEmpty.textContent = 'Aucun poisson sélectionné pour le moment.';
      trEmpty.appendChild(tdEmpty);
      tbody.appendChild(trEmpty);
    }
  }

  function recalculerPopulationPoissons() {
    var tankInput   = document.getElementById('tankGallons');
    var rockInput   = document.getElementById('rockLbs');
    var rockRecP    = document.getElementById('rockRecommendation');
    var filtSelect  = document.getElementById('filtration');
    var refugeCb    = document.getElementById('hasRefuge');
    var usageElem   = document.getElementById('tankUsage');
    var adviceElem  = document.getElementById('adviceText');
    var barElem     = document.getElementById('tankUsageBar');
    var badgeElem   = document.getElementById('tankUsageBadge');

    var gallons = tankInput ? (parseFloat(tankInput.value) || 0) : 0;
    var rockLbs = rockInput ? (parseFloat(rockInput.value) || 0) : 0;

    // Texte de roche vivante
    if (rockRecP) {
      if (gallons > 0) {
        var recommended = gallons;
        var txt = 'Recommandation : environ ' + recommended.toFixed(1) +
          ' lb de roche vivante pour un bac de ' + gallons.toFixed(1) + ' gallons. ' +
          'Vous avez indiqué ' + rockLbs.toFixed(1) + ' lb. ' +
          'La règle des 2 po de poissons par gallon s’applique seulement lorsque vous êtes proche de 1 lb de roche par gallon.';
        rockRecP.textContent = txt;
      } else {
        rockRecP.textContent =
          'Recommandation générale : 1 lb de roche vivante par gallon. ' +
          'La règle des 2 po de poissons par gallon suppose que cette quantité de roches est respectée.';
      }
    }

    // Met à jour le tableau des poissons sélectionnés
    mettreAJourTableauResultats();

    if (!usageElem || !adviceElem) return;

    if (gallons <= 0) {
      usageElem.textContent = '-';
      adviceElem.textContent = 'Entrez le volume de votre aquarium pour démarrer le calcul.';
      if (barElem) barElem.style.width = '0%';
      if (badgeElem) {
        badgeElem.textContent = 'En attente de données.';
        badgeElem.className = 'progress-note status-idle';
      }
      return;
    }

    // Capacité brute (2 po/gal)
    var baseCapacityInches = gallons * 2;

    // Facteur roche vivante
    var rockFactor = 1;
    if (gallons > 0) {
      var ratio = rockLbs / gallons;
      if (ratio >= 1) rockFactor = 1;
      else if (ratio > 0) rockFactor = ratio;
      else rockFactor = 0;
    }

    // Facteur filtration
    var filtrationValue = filtSelect ? filtSelect.value : 'hob';
    var filtrationFactor = 1;
    if (filtrationValue === 'basic')    filtrationFactor = 0.9;
    if (filtrationValue === 'hob')      filtrationFactor = 1.0;
    if (filtrationValue === 'canister') filtrationFactor = 1.05;
    if (filtrationValue === 'sump')     filtrationFactor = 1.10;

    // Facteur refuge
    var refugeFactor = (refugeCb && refugeCb.checked) ? 1.05 : 1.0;

    // Facteur total de système
    var systemFactor = rockFactor * filtrationFactor * refugeFactor;

    var effectiveCapacityInches = baseCapacityInches * systemFactor;
    var totalInches = calculerTotalPouces();

    window.fishCalc.baseCapacityInches      = baseCapacityInches;
    window.fishCalc.effectiveCapacityInches = effectiveCapacityInches;
    window.fishCalc.rockFactor              = rockFactor;
    window.fishCalc.filtrationFactor        = filtrationFactor;
    window.fishCalc.refugeFactor            = refugeFactor;

    if (effectiveCapacityInches <= 0) {
      usageElem.textContent = totalInches.toFixed(1) + ' po / capacité non disponible (pas assez de roche).';
      adviceElem.textContent = 'Vous n’avez pas assez de roche vivante pour appliquer la règle des 2 po par gallon. Augmentez la quantité de roche avant d’ajouter des poissons.';
      if (barElem) barElem.style.width = '0%';
      if (badgeElem) {
        badgeElem.textContent = 'Pas assez de roche vivante.';
        badgeElem.className = 'progress-note status-alert';
      }
      return;
    }

    var percent = (totalInches / effectiveCapacityInches) * 100;
    if (!isFinite(percent)) percent = 0;

    usageElem.textContent =
      totalInches.toFixed(1) + ' po / ' +
      effectiveCapacityInches.toFixed(1) + ' po (' +
      percent.toFixed(0) + '%)';

    // Barre de progression type AquaStockPro
    if (barElem) {
      var clamped = Math.max(0, Math.min(percent, 130));
      barElem.style.width = clamped + '%';

      if (percent < 70) {
        barElem.style.background = '#4caf50';
      } else if (percent <= 100) {
        barElem.style.background = '#ff9800';
      } else {
        barElem.style.background = '#f44336';
      }
    }

    if (badgeElem) {
      if (totalInches === 0) {
        badgeElem.textContent = 'Aucun poisson sélectionné.';
        badgeElem.className = 'progress-note status-idle';
      } else if (percent < 70) {
        badgeElem.textContent = 'Zone confortable.';
        badgeElem.className = 'progress-note status-ok';
      } else if (percent <= 100) {
        badgeElem.textContent = 'Vous approchez de la limite recommandée.';
        badgeElem.className = 'progress-note status-warn';
      } else {
        badgeElem.textContent = 'Surpeuplement : à corriger.';
        badgeElem.className = 'progress-note status-alert';
      }
    }

    if (totalInches === 0) {
      adviceElem.textContent = 'Aucun poisson sélectionné pour le moment. Ajoutez des poissons pour voir l’impact sur la population.';
    } else if (percent < 70) {
      adviceElem.textContent = 'Votre population est dans une zone confortable. Vous avez encore une bonne marge tant que la qualité de l’eau reste stable.';
    } else if (percent <= 100) {
      adviceElem.textContent = 'Vous approchez de la capacité recommandée. Surveillez vos paramètres et évitez d’ajouter trop d’autres poissons.';
    } else {
      adviceElem.textContent = 'Vous dépassez la capacité recommandée pour ce volume et cette configuration. Il est conseillé de réduire la population ou d’améliorer le système (plus de volume, de roches, meilleure filtration).';
    }
  }

  function initTankTypeToggle() {
    var buttons = document.querySelectorAll('.tank-type-button');
    var noteElem = document.getElementById('tankTypeNote');

    function labelForType(type) {
      if (type === 'reef')      return 'Bac récifal';
      if (type === 'fish-only') return 'Fish only (eau salée sans coraux)';
      if (type === 'fowlr')     return 'FOWLR (fish + roches vivantes)';
      return type;
    }

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');

        var t = btn.getAttribute('data-tank-type') || 'reef';
        window.fishCalc.tankType = t;

        if (noteElem) {
          noteElem.textContent = 'Type de bac sélectionné : ' + labelForType(t) + '.';
        }

        recalculerPopulationPoissons();
      });
    });

    window.fishCalc.tankType = 'reef';
  }

  function initEventListeners() {
    document.addEventListener('input', function(e) {
      if (
        e.target.matches('.fish-qty-input') ||
        e.target.matches('.fish-variant-select') ||
        e.target.id === 'tankGallons' ||
        e.target.id === 'rockLbs' ||
        e.target.id === 'filtration' ||
        e.target.id === 'hasRefuge'
      ) {
        recalculerPopulationPoissons();
      }
    });
  }

  // ⚠️ IMPORTANT POUR SHOPIFY :
  // On appelle directement les fonctions (pas de DOMContentLoaded)
  initTankTypeToggle();
  initEventListeners();
  recalculerPopulationPoissons();
})();
</script>

  </body>
</html>
